pipeline {
    agent any

    tools {
        maven 'Maven'
        jdk 'JAVA21'
    }
    stages {
        stage('Build') {
            steps {
                
                sh 'mvn -f pom.xml clean install '
            }
        }
        stage('Test') {
            steps {
                sh 'mvn -f pom.xml test'
            }
            post {
                always {
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }
        stage('Deliver') { 
            steps {
                sh './jenkins/scripts/deliver.sh' 
            }
        }
    }
}
